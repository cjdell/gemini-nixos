# Nix build result symlinks (recreated by `nix build`)
result*

# Host-side device-operation state (bin/run-job.sh, bin/boot-switch.sh,
# bin/flash-nixos.sh):
logs/
stock-dump/

# Vendored source tarballs — too large for git; historically the kernel
# snapshot + mesa archives. BOTH RETIRED 2026-09-08: mesa's base is
# fetched by hash (pkgs/mesa-geminipda.nix), and the kernel builds from
# the published v6.6 tarball + the tracked delta tree
# (devices/planet-geminipda/kernel/delta/) — no in-repo source archives
# remain. kernel/borrowed/ stays tracked (small, ~14 MB) as the
# pre-2026-09-08 #329 reference until the self-built kernel is
# glass-verified; the submodule content at kernel/base is fetched on
# demand (`git submodule update --init --depth 1 kernel/base`).
*.tar.gz
