#!/usr/bin/env bash
# audio-output — manual built-in-speaker / headphone output selection.
#
# WHY: the Gemini PDA's flanking speakers and the 3.5 mm jack are
# electrically IN PARALLEL on the codec HPL/HPR drivers; the only thing
# that separates "built-in speakers" from "headphones" is the speaker-amp
# enable (SoC pads 243+244, `speaker on|off`).  There is no accdet jack
# detection on this mainline stack yet (docs/hardware.md §jack-detect), so
# the choice is manual:
#     audio-output speaker    -> pads 243/244 HIGH = built-in speakers.
#                                (a plugged headphone also plays them —
#                                parallel net, documented caveat)
#     audio-output headphone  -> pads LOW = 3.5 mm jack only.
# The choice persists in /etc/gemini/audio-output-mode and is re-applied
# at every boot by gemini-audio-defaults.service. The same file is kept in
# sync by gemini-speakerd when the output is chosen in GNOME instead of
# with this CLI (the daemon follows the default sink and rewrites the mode
# accordingly — pkgs/gemcli/src/speaker.rs). [added 2026-09-11]
#
# It ALSO sets the PipeWire default sink so the GNOME Sound menu / Quick
# Settings output picker agrees with the amp state (2026-09-10):
#     speaker   -> default sink gemini_speakers (the L/R-correcting
#                  virtual sink, services/pipewire/60-gemini-speakers.conf)
#     headphone -> default sink alsa_output.platform-sound.stereo-fallback
#                  (the hardware sink; only its description is renamed)
# gemini-speakerd follows the default sink and keeps the amp in sync, so
# changing the output in GNOME is enough. `sync-default` is the
# retryable boot-time half (PipeWire may still be starting when
# gemini-audio-defaults runs).
#
# Used by: the gemini-pda-utils CLI, LXQt desktop launchers, the LXQt
# panel CustomCommand output widget (display+click-toggle).
#
# (Ported verbatim from the GeminiPDA project; the speaker CLI lives next
# to this script in the gemini-pda-utils bin dir, substituted at package
# build time.)
set -u

STATE=/etc/gemini/audio-output-mode
SPEAKER="${SPEAKER_BIN:-__GEMINI_UTILS__/speaker}"

# PipeWire sink names (services/pipewire/*.conf). The hardware sink keeps
# its ALSA/ACP name (only its description is renamed); gemini_speakers is
# the L/R-correcting virtual sink.
SINK_SPEAKERS=gemini_speakers
SINK_HEADPHONES=alsa_output.platform-sound.stereo-fallback

# The one PipeWire system session (services/audio.nix).
AUDIO_RUNTIME_DIR="${PIPEWIRE_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/gemwl-audio}}"

die() { echo "audio-output: $*" >&2; exit 1; }

# Write PipeWire's *configured* default sink (the key GNOME/pactl write;
# WirePlumber resolves it to default.audio.sink). Non-zero when PipeWire
# is not reachable yet (early boot) — `apply` only warns, `sync-default`
# lets the caller retry.
set_default_sink() { # name
  command -v pw-metadata >/dev/null 2>&1 || return 1
  PIPEWIRE_RUNTIME_DIR="$AUDIO_RUNTIME_DIR" XDG_RUNTIME_DIR="$AUDIO_RUNTIME_DIR" \
    pw-metadata -n default 0 default.configured.audio.sink \
      "{\"name\":\"$1\"}" Spa:String:JSON >/dev/null 2>&1
}

apply() { # mode  -> flip the amp pads + default sink + persist the choice
  # /etc/gemini may not exist on a fresh rootfs (NixOS does not create
  # plain /etc subdirs); services/audio.nix also ships a tmpfiles rule.
  # [fixed 2026-09-11 — the write silently failed, so the stored mode
  # never persisted]
  mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
  case "$1" in
    speaker)
      "$SPEAKER" on || die "speaker on failed"
      set_default_sink "$SINK_SPEAKERS" \
        || echo "audio-output: PipeWire not reachable; will sync the default sink later" >&2
      echo "$1" > "$STATE"
      ;;
    headphone)
      "$SPEAKER" off || die "speaker off failed"
      set_default_sink "$SINK_HEADPHONES" \
        || echo "audio-output: PipeWire not reachable; will sync the default sink later" >&2
      echo "$1" > "$STATE"
      ;;
    *) die "unknown mode '$1' (want speaker|headphone)" ;;
  esac
}

mode="$(cat "$STATE" 2>/dev/null || echo speaker)"
case "${1:-status}" in
  speaker|headphone) apply "$1" ;;
  toggle)
    [ "$mode" = speaker ] && apply headphone || apply speaker
    ;;
  sync-default) # set the PipeWire default sink to match the stored mode
    case "$mode" in
      speaker)   set_default_sink "$SINK_SPEAKERS" ;;
      headphone) set_default_sink "$SINK_HEADPHONES" ;;
      *) die "unknown stored mode '$mode'" ;;
    esac
    ;;
  status)
    # live pad state (authoritative) vs stored intent — dout= field of pad
    # 243 ("pad 243 (gpio 755): mode=0 dir=out din=0 dout=1"; field 6 is
    # dir=out, NOT the level — parse dout explicitly)
    dout="$( "$SPEAKER" status 2>/dev/null | grep -o 'dout=[01]' | head -1 | cut -d= -f2 )"
    if [ "$dout" = 1 ]; then live_mode=speaker; else live_mode=headphone; fi
    if [ "${2:-}" = --panel ]; then
      # one short line for the LXQt panel CustomCommand widget
      if [ "$live_mode" = speaker ]; then echo "Speakers"; else echo "Headphones"; fi
    else
      echo "mode: $live_mode (stored intent: $mode)"
      echo "speaker amps (pads 243/244): $([ "$dout" = 1 ] && echo ON || echo OFF)"
      echo "headphone jack plays too when mode=speaker and something is plugged (parallel net, no jack detect yet)"
    fi
    ;;
  *) echo "usage: $0 status|speaker|headphone|toggle|sync-default"; exit 2 ;;
esac
