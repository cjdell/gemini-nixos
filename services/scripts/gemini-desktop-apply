#!/bin/sh
# gemini-desktop-apply — resolve the persistent boot-session marker and
# configure the display stack BEFORE display-manager.service starts.
#
# Part of the desktop/session selector (services/desktop-select.nix;
# story + receipts: docs/desktop-selection.md). One Gemini, several
# panel owners — GNOME, COSMIC and niri are all ordinary GDM Wayland
# sessions on the geminipda-drm KMS device, exactly one of which GDM
# auto-logs into; "console" skips the display manager entirely and
# stays on the fbcon console.
#
# Inputs (all overridable by env; the unit sets GEMINI_DESKTOP_DEFAULT
# + GEMINI_DESKTOP_USER from services.geminiDesktop.*):
#   GEMINI_DESKTOP_MARKER   persistent mode file   (default /var/lib/gemini/desktop)
#   GEMINI_DESKTOP_SENTINEL flag file for console  (default /run/gemini-console)
#   GEMINI_DESKTOP_USER     auto-login user        (default cjdell)
#   GEMINI_DESKTOP_DEFAULT  fallback mode          (default gnome)
#
# Modes:
#   gnome | cosmic | niri : set the AccountsService `Session`/`SessionType` for
#                    the auto-login user — the exact mechanism NixOS's
#                    `services.displayManager.defaultSession` uses
#                    (set-session.py, account-service-util.nix) — and
#                    remove the console sentinel so display-manager
#                    runs. GDM reads the session from AccountsService
#                    for auto-login when defaultSession is unset
#                    (services/gnome.nix leaves it unset so the marker
#                    is authoritative).
#   console        : create the sentinel. display-manager.service
#                    carries ConditionPathExists=!/run/gemini-console
#                    (set by the selector module), so it is skipped and
#                    the fbcon console stays. getty.target does NOT
#                    want autovt@tty1 while a display manager is
#                    configured (getty.nix), so bring up an autologin
#                    getty on tty1 explicitly (autologin comes from
#                    services.getty.autologinUser).
#   gemshell       : create the sentinel TOO — but start NO getty and do
#                    NOT chvt: the gemshell compositor (a system service
#                    with ConditionPathExists=/run/gemini-console, see
#                    services/gemshell.nix) owns the panel directly and a
#                    tty1 console would fight the shadow-plane blit for
#                    the same scanout memory. GDM is skipped by the same
#                    condition as in console mode.
#
# Exit 0 = applied, 1 = bad mode / failure (display-manager then still
# runs, i.e. the safe fallback, because no sentinel is created).
set -eu

MARKER=${GEMINI_DESKTOP_MARKER:-/var/lib/gemini/desktop}
SENTINEL=${GEMINI_DESKTOP_SENTINEL:-/run/gemini-console}
USER_NAME=${GEMINI_DESKTOP_USER:-cjdell}
DEFAULT=${GEMINI_DESKTOP_DEFAULT:-gnome}

mode="$DEFAULT"
if [ -r "$MARKER" ]; then
    m=$(tr -d ' \t\r\n' < "$MARKER" 2>/dev/null || true)
    [ -n "$m" ] && mode="$m"
fi

case "$mode" in
    gemshell)
        # Sentinel only: display-manager skips (its Condition), and
        # gemini-gemshell.service starts (its Condition) — NO tty1
        # getty (the compositor owns the panel; see the header).
        : > "$SENTINEL"
        echo "gemini-desktop: gemshell — display-manager skipped, compositor owns the panel"
        ;;
    console)
        : > "$SENTINEL"
        # Bring up the tty1 console getty (see the header for why it is
        # not already wanted). Best-effort: chvt only exists in kbd.
        systemctl start getty@tty1.service 2>/dev/null || true
        if command -v chvt >/dev/null 2>&1; then
            chvt 1 2>/dev/null || true
        fi
        echo "gemini-desktop: console — display-manager skipped, fbcon on tty1"
        ;;
    gnome|cosmic|niri)
        rm -f "$SENTINEL"
        uid=$(id -u "$USER_NAME")
        # All are Wayland sessions. Same two setters set-session.py
        # calls via AccountsService; busctl keeps the script python-free.
        busctl call org.freedesktop.Accounts "/org/freedesktop/Accounts/User$uid" \
            org.freedesktop.Accounts.User SetSession s "$mode"
        busctl call org.freedesktop.Accounts "/org/freedesktop/Accounts/User$uid" \
            org.freedesktop.Accounts.User SetSessionType s wayland
        echo "gemini-desktop: $mode — AccountsService session set for $USER_NAME (uid $uid)"
        ;;
    *)
        echo "gemini-desktop: unknown mode '$mode' — want gnome|cosmic|niri|gemshell|console" >&2
        exit 1
        ;;
esac
