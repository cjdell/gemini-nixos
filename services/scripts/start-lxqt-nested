#!/bin/sh
# start-lxqt-nested — LXQt (Wayland) session nested inside gemwl:
#   LXQt apps -> labwc 0.8.3 (wlroots 0.18 wayland backend, nested on
#   gemwl's wayland-0, socket wayland-1) -> gemwl -> LK fb.
#
# The NixOS port of the verified GeminiPDA lxqt-nested.service start
# script (build/rootfs-files/lxqt-wayland/start-lxqt-nested.sh, live on
# glass since 2026-09-02; LXQt 2.4 packages from nixpkgs instead of
# Debian's 2.1). Run by services/lxqt.nix's lxqt-nested.service.
#
# The environment is set by the UNIT (services/lxqt.nix), not here —
# HOME/XDG_*, the dbus/Pulse/PipeWire sockets, XDG_CURRENT_DESKTOP,
# QT_PLUGIN_PATH (qtbase/qtwayland/lxqt-qtplugin), XDG_CONFIG_DIRS (the
# lxqt packages' etc/xdg autostart), XDG_DATA_DIRS (icon theme, lxqt
# themes, the vendored labwc theme), PAN_MESA_DEBUG. Tools (dbus-daemon,
# labwc, lxqt-session, wlr-randr, ...) come from the unit's path=.
#
# GEMINI_LXQT_CONFIGS (set by the unit) = the repo's config/lxqt/ store
# dir ($out/{lxqt/, labwc/, themerc, Desktop/}) — seeded to /root once
# (idempotent; never overwrites user changes):
#   $…/lxqt/lxqt.conf            -> /root/.config/lxqt/lxqt.conf
#   $…/lxqt/panel.conf           -> /root/.config/lxqt/panel.conf (only
#                                  when absent — a live panel.conf is a
#                                  user file; add the [statusnotifier]
#                                  tray manually on existing installs)
#   $…/lxqt/session.conf         -> /root/.config/lxqt/session.conf
#   $…/labwc/rc.xml              -> /root/.config/labwc/rc.xml
#   $…/labwc/autostart           -> /root/.config/labwc/autostart
#   $…/themerc                   -> /root/.local/share/themes/Gemini/openbox-3/themerc
#   $…/Desktop/*.desktop         -> /root/Desktop/
set -e

[ -n "${GEMINI_LXQT_CONFIGS:-}" ] || { echo "!! GEMINI_LXQT_CONFIGS not set" >&2; exit 1; }
SRC=$GEMINI_LXQT_CONFIGS

# 1. seed user configs (first boot / after a wipe only)
seed_if_absent() { # src target
    [ -f "$2" ] || { mkdir -p "$(dirname "$2")" && cp "$1" "$2"; }
}
seed_if_absent "$SRC/lxqt/lxqt.conf"   /root/.config/lxqt/lxqt.conf
seed_if_absent "$SRC/lxqt/panel.conf"  /root/.config/lxqt/panel.conf
seed_if_absent "$SRC/lxqt/session.conf" /root/.config/lxqt/session.conf
seed_if_absent "$SRC/labwc/rc.xml"     /root/.config/labwc/rc.xml
seed_if_absent "$SRC/labwc/autostart"  /root/.config/labwc/autostart
seed_if_absent "$SRC/themerc"          /root/.local/share/themes/Gemini/openbox-3/themerc
for f in "$SRC"/Desktop/*.desktop; do
    [ -f "$f" ] && seed_if_absent "$f" "/root/Desktop/$(basename "$f")"
done
chmod 755 /root/.config/labwc/autostart 2>/dev/null || true

# 2. session bus (lxqt-session/panel share it; /run/gemwl is gemwl's
#    RuntimeDirectory — exists because lxqt-nested is After=gemwl)
mkdir -p /run/gemwl
if [ ! -S /run/gemwl/bus ]; then
    dbus-daemon --session --address=unix:path=/run/gemwl/bus --fork --print-address >/dev/null
    sleep 1
fi
[ -S /run/gemwl/bus ] || { echo "!! session bus did not come up" >&2; exit 1; }

# 3. wait for gemwl's socket (cold-boot ordering; gemwl may still be in
#    panfrost-load.sh's rmmod+reprobe when this unit starts)
i=0
while [ $i -lt 120 ] && [ ! -S /run/gemwl/wayland-0 ]; do
    sleep 0.5
    i=$((i+1))
done
[ -S /run/gemwl/wayland-0 ] || { echo "!! gemwl socket wayland-0 never appeared" >&2; exit 1; }

# 4. (best-effort) scale the nested output 1.5x once labwc is up —
#    0.8.3 has no config-file scale; wlr-randr (wlr-output-management)
#    is the way. labwc picks the next free socket in XDG_RUNTIME_DIR
#    (wayland-1 here, gemwl holds wayland-0) — probe a few.
( i=0
  while [ $i -lt 60 ]; do
      for s in wayland-1 wayland-2 wayland-3; do
          if [ -S "/run/gemwl/$s" ] && WAYLAND_DISPLAY="$s" wlr-randr 2>/dev/null | grep -q 'WL-1'; then
              WAYLAND_DISPLAY="$s" wlr-randr --output WL-1 --scale 1.5 2>/dev/null || true
              break 2
          fi
      done
      i=$((i+1)); sleep 0.5
  done ) &

# 5. labwc nested in gemwl; lxqt-session is labwc's session client
#    (-S terminates labwc when the session exits). -d = debug logging to
#    the journal (2026-09-02: needed to trace client-buffer import; keep
#    until the nested desktop is verified, then drop).
WAYLAND_DISPLAY=wayland-0 WLR_BACKENDS=wayland \
    exec labwc -d -C /root/.config/labwc -S lxqt-session
