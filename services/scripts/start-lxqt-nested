#!/bin/sh
# start-lxqt-nested — LXQt (Wayland) session nested inside gemwl:
#   LXQt apps -> labwc 0.8.3 (wlroots 0.18 wayland backend, nested on
#   gemwl's wayland-0, socket wayland-1) -> gemwl -> LK fb.
#
# The NixOS port of the verified GeminiPDA lxqt-nested.service start
# script (build/rootfs-files/lxqt-wayland/start-lxqt-nested.sh, live on
# glass since 2026-09-02; LXQt 2.4 packages from nixpkgs instead of
# Debian's 2.1). Run by services/lxqt.nix's lxqt-nested.service.
#
# [2026-09-09] The session runs as cjdell — the device's DEFAULT desktop
# user (services/lxqt.nix sets User=cjdell + HOME/XDG_*). All user state
# (seeds, configs, Desktop) lives under $HOME (/home/cjdell), NOT /root:
# the root-owned "system service desktop" model is gone.
#
# The environment is set by the UNIT (services/lxqt.nix), not here —
# HOME/XDG_* (HOME=/home/cjdell, XDG_RUNTIME_DIR=/run/lxqt-session — the
# unit's cjdell-owned RuntimeDirectory), the dbus/Pulse/PipeWire socket
# addresses, XDG_CURRENT_DESKTOP, QT_PLUGIN_PATH (qtbase/qtwayland/
# lxqt-qtplugin), XDG_CONFIG_DIRS (the lxqt packages' etc/xdg autostart),
# XDG_DATA_DIRS (icon theme, lxqt themes, the vendored labwc theme),
# PAN_MESA_DEBUG. Tools (dbus-daemon, labwc, lxqt-session, wlr-randr,
# ...) come from the unit's path=.
#
# GEMINI_LXQT_CONFIGS (set by the unit) = the repo's config/lxqt/ store
# dir ($out/{lxqt/, labwc/, themerc, Desktop/}) — seeded to $HOME once
# (idempotent; never overwrites user changes):
#   $…/lxqt/lxqt.conf            -> $HOME/.config/lxqt/lxqt.conf
#   $…/lxqt/panel.conf           -> $HOME/.config/lxqt/panel.conf (only
#                                  when absent — a live panel.conf is a
#                                  user file; add the [statusnotifier]
#                                  tray manually on existing installs)
#   $…/lxqt/session.conf         -> $HOME/.config/lxqt/session.conf
#   $…/labwc/rc.xml              -> $HOME/.config/labwc/rc.xml
#   $…/labwc/autostart           -> $HOME/.config/labwc/autostart
#   $…/themerc                   -> $HOME/.local/share/themes/Gemini/openbox-3/themerc
#   $…/Desktop/*.desktop         -> $HOME/Desktop/
set -e

[ -n "${GEMINI_LXQT_CONFIGS:-}" ] || { echo "!! GEMINI_LXQT_CONFIGS not set" >&2; exit 1; }
[ -n "${HOME:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] || {
    echo "!! HOME/XDG_RUNTIME_DIR not set (unit must set User=cjdell + env)" >&2; exit 1; }
SRC=$GEMINI_LXQT_CONFIGS
RUNTIME=$XDG_RUNTIME_DIR

# 1. seed user configs (first boot / after a wipe only)
seed_if_absent() { # src target
    [ -f "$2" ] || { mkdir -p "$(dirname "$2")" && cp "$1" "$2"; }
}
seed_if_absent "$SRC/lxqt/lxqt.conf"   "$HOME/.config/lxqt/lxqt.conf"
seed_if_absent "$SRC/lxqt/panel.conf"  "$HOME/.config/lxqt/panel.conf"
seed_if_absent "$SRC/lxqt/session.conf" "$HOME/.config/lxqt/session.conf"
seed_if_absent "$SRC/labwc/rc.xml"     "$HOME/.config/labwc/rc.xml"
seed_if_absent "$SRC/labwc/autostart"  "$HOME/.config/labwc/autostart"
seed_if_absent "$SRC/themerc"          "$HOME/.local/share/themes/Gemini/openbox-3/themerc"
for f in "$SRC"/Desktop/*.desktop; do
    [ -f "$f" ] && seed_if_absent "$f" "$HOME/Desktop/$(basename "$f")"
done
chmod 755 "$HOME/.config/labwc/autostart" 2>/dev/null || true

# 2. session bus (lxqt-session/panel share it; the bus socket lives in
#    THIS unit's RuntimeDirectory — $XDG_RUNTIME_DIR is /run/lxqt-
#    session, cjdell-owned, created by systemd. gemwl.service's /run/
#    gemwl exists because lxqt-nested is After=gemwl, but it is gemwl's
#    root-owned dir — the bus does NOT go there anymore [2026-09-09]).
mkdir -p "$RUNTIME"
if [ ! -S "$RUNTIME/bus" ]; then
    dbus-daemon --session --address="unix:path=$RUNTIME/bus" --fork --print-address >/dev/null
    sleep 1
fi
[ -S "$RUNTIME/bus" ] || { echo "!! session bus did not come up" >&2; exit 1; }

# 3. wait for gemwl's socket (cold-boot ordering; gemwl may still be in
#    panfrost-load.sh's rmmod+reprobe when this unit starts). gemwl is a
#    root service; its socket stays at /run/gemwl/wayland-0 (dir 0755,
#    socket 0666 — services/desktop.nix).
i=0
while [ $i -lt 120 ] && [ ! -S /run/gemwl/wayland-0 ]; do
    sleep 0.5
    i=$((i+1))
done
[ -S /run/gemwl/wayland-0 ] || { echo "!! gemwl socket wayland-0 never appeared" >&2; exit 1; }

# 3b. libwayland resolves a BARE WAYLAND_DISPLAY name against
#    XDG_RUNTIME_DIR — but gemwl's socket lives in gemwl's own runtime
#    dir (/run/gemwl), and this session's XDG_RUNTIME_DIR is its own
#    cjdell-owned dir. Symlink wayland-0 in so `WAYLAND_DISPLAY=
#    wayland-0` (below) reaches gemwl. (Before 2026-09-09 the root
#    session shared gemwl's dir and the bare name just worked — this is
#    the cost of running the session as cjdell.) The symlink dies with
#    the RuntimeDirectory on restart and is recreated here.
[ -e "$RUNTIME/wayland-0" ] || ln -s /run/gemwl/wayland-0 "$RUNTIME/wayland-0"

# 4. (best-effort) scale the nested output 1.5x once labwc is up —
#    0.8.3 has no config-file scale; wlr-randr (wlr-output-management)
#    is the way. labwc picks the next free socket in XDG_RUNTIME_DIR
#    (wayland-1 here, gemwl holds wayland-0) — probe a few.
( i=0
  while [ $i -lt 60 ]; do
      for s in wayland-1 wayland-2 wayland-3; do
          if [ -S "$RUNTIME/$s" ] && WAYLAND_DISPLAY="$s" wlr-randr 2>/dev/null | grep -q 'WL-1'; then
              WAYLAND_DISPLAY="$s" wlr-randr --output WL-1 --scale 1.5 2>/dev/null || true
              break 2
          fi
      done
      i=$((i+1)); sleep 0.5
  done ) &

# 5. labwc nested in gemwl; lxqt-session is labwc's session client
#    (-S terminates labwc when the session exits). -d = debug logging to
#    the journal (2026-09-02: needed to trace client-buffer import; keep
#    until the nested desktop is verified, then drop).
WAYLAND_DISPLAY=wayland-0 WLR_BACKENDS=wayland \
    exec labwc -d -C "$HOME/.config/labwc" -S lxqt-session
