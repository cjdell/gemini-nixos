#!/bin/sh
# start-phosh-shell — the phosh-nested unit's phoc -E session launcher
# (services/phosh.nix). phoc runs this once its socket is up, with
# WAYLAND_DISPLAY already set to phoc's socket ("phosh" — phoc
# g_setenvs it before running the -E command, src/server.c). This
# script:
#
#   1. starts squeekboard (the OSK) in the background with a
#      respawn-guard. phosh does NOT spawn it — phosh's osk-manager
#      only toggles visibility on the sm.puri.OSK0 D-Bus name
#      (VIRTBOARD_DBUS_NAME, src/osk-manager.c) and shows "no OSK"
#      when nobody owns it. squeekboard is a Wayland client of phoc
#      (input-method + layer-shell) and shows itself only when phosh
#      tells it to — hardware-keyboard-only use never sees it.
#   2. execs the phosh shell itself (the $out/libexec/phosh binary;
#      NOT bin/phosh-session, which starts its OWN phoc on DRM — we are
#      already inside phoc). When phosh exits, this script exits, phoc
#      (its -E child ended) exits, and the unit's Restart=on-failure
#      decides: clean exit = session over; crash = restart loop like
#      lxqt-nested.
#
# Env comes from the unit: XDG_RUNTIME_DIR=/run/phosh-session (the
# unit's cjdell-owned RuntimeDirectory — where phoc's "phosh" socket
# lives), DBUS_SESSION_BUS_ADDRESS=unix:path=/run/phosh-session/bus,
# PHOSH_SHELL_BIN=<store path>/libexec/phosh, PATH carries squeekboard
# + dbus tools. [2026-09-09: session user is cjdell, not root.]
set -e

[ -n "${WAYLAND_DISPLAY:-}" ] || { echo "!! no WAYLAND_DISPLAY (phoc -E did not set it)" >&2; exit 1; }
[ -n "${PHOSH_SHELL_BIN:-}" ] || { echo "!! PHOSH_SHELL_BIN not set (unit env)" >&2; exit 1; }

# 1. OSK with a respawn guard (a squeekboard crash should not take the
#    whole session down; exit 0 (clean) stops the guard).
if command -v squeekboard >/dev/null 2>&1; then
    (
        while :; do
            squeekboard
            rc=$?
            [ "$rc" -eq 0 ] && exit 0
            sleep 2
        done
    ) &
fi

# 2. the shell (foreground — its lifetime == the session's)
exec "$PHOSH_SHELL_BIN"
