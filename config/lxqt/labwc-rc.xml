<?xml version="1.0"?>
<!-- labwc rc.xml for the Gemini PDA LXQt (Wayland) session.
     Seeded to $HOME/.config/labwc/rc.xml by
     services/scripts/start-lxqt-nested (only if absent); labwc is
     launched with -C $HOME/.config/labwc ($HOME = /home/cjdell — the
     cjdell desktop session, 2026-09-09). Ported from the verified
     GeminiPDA build/rootfs-files/lxqt-wayland/labwc-rc.xml (2026-09-02
     A/B + 2026-09-04 decoration receipts) with the theme pointed at the
     vendored "Gemini" openbox themerc (this repo, config/lxqt/themerc —
     labwc reads <data-dir>/themes/Gemini/openbox-3/themerc). -->

<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>0</gap>
    <adaptiveSync>no</adaptiveSync>
    <allowTearing>no</allowTearing>
    <autoEnableOutputs>yes</autoEnableOutputs>
    <reuseOutputMode>no</reuseOutputMode>
    <xwaylandPersistence>no</xwaylandPersistence>
    <primarySelection>yes</primarySelection>
  </core>

  <placement>
    <policy>cascade</policy>
  </placement>

  <theme>
    <!-- "Gemini" = the vendored openbox themerc (config/lxqt/themerc).
         The Debian config named themes that were NOT installed on the
         device rootfs and labwc then drew NO titlebars (2026-09-04
         receipt: theme must exist at
         /usr/share/themes/<name>/openbox-3/themerc or, here, an XDG
         data dir). The vendored themerc is Clearlooks-style (blue
         active / gray inactive, high contrast). -->
    <name>Gemini</name>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <cornerRadius>8</cornerRadius>
    <keepBorder>yes</keepBorder>
    <dropShadows>no</dropShadows>
    <font place="ActiveWindow">
      <name>sans</name><size>13</size><slant>normal</slant><weight>normal</weight>
    </font>
    <font place="InActiveWindow">
      <name>sans</name><size>13</size><slant>normal</slant><weight>normal</weight>
    </font>
    <font place="MenuHeader">
      <name>sans</name><size>12</size><slant>normal</slant><weight>normal</weight>
    </font>
    <font place="MenuItem">
      <name>sans</name><size>12</size><slant>normal</slant><weight>normal</weight>
    </font>
    <font place="OnScreenDisplay">
      <name>sans</name><size>13</size><slant>normal</slant><weight>normal</weight>
    </font>
  </theme>

  <resistance>
    <screenEdgeStrength>20</screenEdgeStrength>
    <windowEdgeStrength>20</windowEdgeStrength>
  </resistance>

  <focus>
    <followMouse>no</followMouse>
    <followMouseRequiresMovement>yes</followMouseRequiresMovement>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <desktops>
    <popupTime>1000</popupTime>
    <names>
      <name>Default</name>
    </names>
  </desktops>

  <!-- Full default keybindings + mousebindings (labwc built-ins). -->
  <keyboard>
    <default />
  </keyboard>
  <mouse>
    <default />
  </mouse>

  <menu>
    <ignoreButtonReleasePeriod>250</ignoreButtonReleasePeriod>
    <showIcons>yes</showIcons>
  </menu>

  <!--
    labwc 0.8.3 decoration gotcha (root-caused 2026-09-04 from source):
    EVERY xdg-shell view starts with ssd_preference = LAB_SSD_PREF_CLIENT
    (src/xdg.c, xdg_toplevel_new()). Only clients that REGISTER
    xdg_toplevel_decoration (Qt/GTK apps) get server-side decorations.
    Clients that never register the protocol (our C clients
    wlegltst/tinytest/tinytest-anim, weston-simple-egl, ...) therefore
    get NO titlebar no matter what <core><decoration> says. The
    window-rule escape hatch (checked FIRST in view_wants_decorations)
    forces SSD for the matching app_id (case-insensitive shell glob).
    User-verified on glass 2026-09-04. Add app_ids here as new native
    GL/Wayland clients appear.
  -->
  <windowRules>
    <windowRule identifier="org.freedesktop.weston.*" serverDecoration="yes"/>
    <windowRule identifier="wlegltst" serverDecoration="yes"/>
    <windowRule identifier="tinytest*" serverDecoration="yes"/>
  </windowRules>

</labwc_config>
