#!/bin/sh
# labwc autostart — seeded to $HOME/.config/labwc/autostart by
# services/scripts/start-lxqt-nested (only if absent); runs when labwc
# starts.
#
# LXQt itself is labwc's session client (-S lxqt-session): lxqt-session
# assembles the desktop from the XDG autostart entries of the installed
# lxqt packages (lxqt-panel, pcmanfm-qt --desktop, lxqt-policykit-agent,
# lxqt-notificationd — all OnlyShowIn=LXQt; the lxqt-nested unit puts
# their etc/xdg on XDG_CONFIG_DIRS), so nothing LXQt-ish belongs here.
# qterminal is started here (like the verified Debian autostart) as the
# first visible Qt/EGL window proving the client chain on glass.
qterminal &
